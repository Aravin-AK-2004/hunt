{
  "version": 2,
  "builds": [
    { "src": "api/hunters.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "css/styles.css", "use": "@vercel/static" },
    { "src": "js/app.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/hunters", "dest": "/api/hunters.js" },
    { "src": "/css/styles.css", "dest": "/css/styles.css" },
    { "src": "/js/app.js", "dest": "/js/app.js" },
    { "src": "/", "dest": "/index.html" }
  ]
}
